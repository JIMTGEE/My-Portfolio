# Copy this file to .env.local for local development, and set the same
# values as Environment Variables in your Vercel project for production.
# Nothing here is required to run `npm run dev` — the site degrades
# gracefully (see README) when these are missing.

# Public URL of the deployed site. Used for SEO metadata, Open Graph tags,
# the sitemap, and robots.txt. Set this to your real domain once you have
# one; the dev default is fine for local work.
NEXT_PUBLIC_SITE_URL=https://tohybu.dev

# --- Contact form email delivery (optional) ---------------------------
# Without these two, the contact form shows a friendly "not configured"
# message with a mailto fallback instead of trying to send. Get an API
# key from https://resend.com (free tier is plenty for a portfolio) and
# verify a sending domain there.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Must be on a domain you've verified with Resend. The default
# onboarding@resend.dev works for testing but is rate-limited and not
# meant for production use.
CONTACT_FROM_EMAIL="Portfolio Contact <onboarding@resend.dev>"
